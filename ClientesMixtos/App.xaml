<Application x:Class="ClientesMixtos.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClientesMixtos.Views"
             xmlns:vm="clr-namespace:ClientesMixtos.ViewModels">
    <Application.Resources>
        <ResourceDictionary>

            <!-- THEME BRUSHES -->
            <SolidColorBrush x:Key="BrushWindowBg" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="BrushCardBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BrushSurfaceLight" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="BrushTextPrimary" Color="#111827"/>
            <SolidColorBrush x:Key="BrushTextSecondary" Color="#374151"/>
            <SolidColorBrush x:Key="BrushTextMuted" Color="#6B7280"/>
            <SolidColorBrush x:Key="BrushTextDisabled" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="BrushBorder" Color="#E5E7EB"/>
            <SolidColorBrush x:Key="BrushBorderInput" Color="#D1D5DB"/>
            <SolidColorBrush x:Key="BrushBorderLight" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="BrushPrimaryLight" Color="#DBEAFE"/>
            <SolidColorBrush x:Key="BrushSelected" Color="#BFDBFE"/>
            <SolidColorBrush x:Key="BrushDangerLight" Color="#FCA5A5"/>
            <SolidColorBrush x:Key="BrushWarningLight" Color="#FDE047"/>
            <SolidColorBrush x:Key="BrushSuccessLight" Color="#86EFAC"/>
            <SolidColorBrush x:Key="BrushOverdueLight" Color="#FECACA"/>
            <SolidColorBrush x:Key="BrushOverdueDark" Color="#BAE6FD"/>

            <Color x:Key="Primary">#2563EB</Color>
            <Color x:Key="PrimaryDark">#1D4ED8</Color>
            <Color x:Key="PrimaryLight">#DBEAFE</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="Background">#F3F4F6</Color>
            <Color x:Key="TextPrimary">#111827</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>
            <Color x:Key="Border">#E5E7EB</Color>
            <Color x:Key="Success">#10B981</Color>
            <Color x:Key="Warning">#F59E0B</Color>
            <Color x:Key="Danger">#EF4444</Color>
            <Color x:Key="Info">#8B5CF6</Color>

            <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2563EB" Offset="0"/>
                <GradientStop Color="#1D4ED8" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#F9FAFB" Offset="1"/>
            </LinearGradientBrush>

            <DropShadowEffect x:Key="CardShadow" ShadowDepth="2" Direction="270" Opacity="0.08" BlurRadius="8"/>
            <DropShadowEffect x:Key="ElevatedShadow" ShadowDepth="4" Direction="270" Opacity="0.12" BlurRadius="12"/>

            <DataTemplate DataType="{x:Type vm:PanelViewModel}">
                <local:PanelView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
                <local:ConfigView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ClientesViewModel}">
                <local:ClientesView/>
            </DataTemplate>

            <!-- NAV RADIO BUTTON -->
            <Style x:Key="NavRadioButton" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Width" Value="85"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Border"
                                    Background="Transparent"
                                    CornerRadius="8">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrushWindowBg}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2563EB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- MODERN RADIO BUTTON -->
            <Style x:Key="ModernRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22">
                                    <Ellipse x:Name="OuterCircle"
                                             Fill="{DynamicResource BrushCardBg}"
                                             Stroke="{DynamicResource BrushBorderInput}"
                                             StrokeThickness="2"/>
                                    <Ellipse x:Name="InnerCircle"
                                             Width="12" Height="12"
                                             Fill="#2563EB"
                                             Visibility="Collapsed"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Grid>
                                <ContentPresenter Margin="8,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OuterCircle" Property="Stroke" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="OuterCircle" Property="Stroke" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- MODERN TEXT BOX -->
            <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInput}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextDisabled}"/>
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrushSurfaceLight}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ACTION BUTTON -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="#2563EB"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- MODERN PASSWORD BOX -->
            <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInput}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextDisabled}"/>
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrushSurfaceLight}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- OUTLINE BUTTON -->
            <Style x:Key="OutlineButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInput}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrushSurfaceLight}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushTextDisabled}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrushWindowBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- COMBO BOX ITEM -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd"
                                    Margin="2"
                                    CornerRadius="6"
                                    Background="Transparent">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryLight}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSelected}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- MODERN COMBO BOX -->
            <Style x:Key="ModernComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInput}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <Grid>
                                        <ContentPresenter Margin="10,0,35,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Content="{TemplateBinding SelectionBoxItem}"/>
                                        <ToggleButton Background="{DynamicResource BrushCardBg}" BorderThickness="0"
                                                       Focusable="False" ClickMode="Press"
                                                       IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderInput}"
                                            BorderThickness="1" CornerRadius="8"
                                            Effect="{StaticResource ElevatedShadow}">
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- MODERN DATE PICKER -->
            <Style x:Key="ModernDatePickerStyle" TargetType="DatePicker">
                <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderInput}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Resources>
                    <Style TargetType="Calendar">
                        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                    </Style>
                </Style.Resources>
            </Style>
            <Style TargetType="CalendarItem">
                <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            </Style>

            <!-- MODERN DATA GRID -->
            <Style x:Key="ModernDataGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="RowBackground" Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
                <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Style.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BrushSurfaceLight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="5,12"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderLight}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <DataTrigger Binding="{Binding State.Pendiente}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushDangerLight}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State.Pendiente}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource BrushWarningLight}"/>
                            </DataTrigger>
                            
                            <DataTrigger Binding="{Binding State.AtrasoGrave}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushOverdueDark}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding State.PagoEsteMes}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushSuccessLight}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Perdido}" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Recuperado}" Value="True">
                                <Setter Property="Background" Value="#F59E0B"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Saldado}" Value="True">
                                <Setter Property="Background" Value="#7F60FF"/>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="16,8"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Style.Resources>
            </Style>

            <!-- MODERN INT TEXT BOX -->
            <Style x:Key="ModernIntTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Validation.ErrorTemplate">
                    <Setter.Value>
                        <ControlTemplate/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- STAT CARD -->
            <Style x:Key="StatCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderLight}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- MODERN CHECKBOX -->
            <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
