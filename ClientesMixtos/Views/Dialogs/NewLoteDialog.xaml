<Window x:Class="ClientesMixtos.Views.Dialogs.NewLoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientesMixtos.Views.Dialogs"
        mc:Ignorable="d"
        Title="Nuevo Lote" Height="260" Width="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBg}">

    <Border Background="{DynamicResource BrushCardBg}" CornerRadius="12" Effect="{StaticResource CardShadow}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="16">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Nuevo Lote" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Número de lote" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Lote, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="34"
                     HorizontalAlignment="Center"
                     Style="{StaticResource ModernTextBoxStyle}"/>
            <Button Style="{StaticResource ActionButtonStyle}"
                Content="Guardar" Width="120" Height="34" Margin="0,16,0,0"
                Command="{Binding GuardarCommand}" HorizontalAlignment="Center" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>
