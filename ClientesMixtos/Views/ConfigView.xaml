<UserControl x:Class="ClientesMixtos.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClientesMixtos.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource BrushWindowBg}">

    <Border Background="{DynamicResource BrushCardBg}" CornerRadius="12" Effect="{StaticResource CardShadow}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="24">
        <ScrollViewer>
            <StackPanel Margin="28,24">
                <TextBlock Text="Configuración" 
               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>

                <Border Background="{DynamicResource BrushSurfaceLight}" CornerRadius="8" Margin="0,20,0,0"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Conexión a Base de Datos" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="Los cambios requieren reiniciar la aplicación" 
                       FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,12"/>

                        <TextBlock Text="Connection String" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <TextBlock Text="Nombre de Base de Datos" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BrushSurfaceLight}" CornerRadius="8" Margin="0,16,0,0"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="PIN de Seguridad" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Text="Configure o actualice el PIN de acceso al sistema" 
                       FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,12"/>
                        <Button Content="Configurar PIN" Width="130" Height="34"
                    Command="{Binding ConfigurePINCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Button Content="Guardar Configuración" Width="180" Height="38"
                        Command="{Binding SaveConfigCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#3B82F6"
                        HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>
        
    </Border>
</UserControl>
