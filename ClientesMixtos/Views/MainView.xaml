<Window x:Class="ClientesMixtos.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientesMixtos.Views"
        xmlns:vm="clr-namespace:ClientesMixtos.ViewModels"
        mc:Ignorable="d"
        Title="Clientes Mixtos" 
        Height="680" MinHeight="520"
        Width="1100" MinWidth="900"
        WindowStartupLocation="CenterOwner" 
        BorderThickness="0"
        ResizeMode="CanResizeWithGrip"
>
    <Grid Background="{DynamicResource BrushWindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource BrushCardBg}" Effect="{StaticResource CardShadow}">
            <DockPanel Margin="24,0,24,0">
                <TextBlock Text="Clientes Mixtos" 
                           FontSize="16" FontWeight="Bold" 
                           Foreground="{DynamicResource BrushTextPrimary}"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <RadioButton Style="{StaticResource NavRadioButton}" 
                            Content="Panel"
                            Command="{Binding ShowPanelCommand}"
                            IsChecked="True"
                            />

                    <RadioButton Style="{StaticResource NavRadioButton}" 
                            Content="Clientes"
                            Command="{Binding ShowClientesCommand}"
                            />

                    <RadioButton Style="{StaticResource NavRadioButton}" 
                            Content="Config"
                            Command="{Binding ShowConfigCommand}"
                            />

                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource BrushWindowBg}">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource BrushSurfaceLight}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding ConnectionStatusColor}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ConnectionStatus}" 
                               FontSize="12" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="↻ Refrescar" 
                        Style="{StaticResource ActionButtonStyle}"
                        Height="30" FontSize="12" Width="90"
                        HorizontalAlignment="Right"
                        Command="{Binding RefreshConnectionCommand}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
