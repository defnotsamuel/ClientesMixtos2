<Window x:Class="ClientesMixtos.Views.NotasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientesMixtos.Views"
        mc:Ignorable="d"
        Title="Notas del Cliente" Height="480" Width="640" MinHeight="380" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBg}">

    <Border Background="{DynamicResource BrushCardBg}" CornerRadius="12" Effect="{StaticResource CardShadow}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="16">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView ItemsSource="{Binding ListaNotas}"
                      SelectedItem="{Binding NotaSeleccionada, Mode=TwoWay}"
                      Background="{DynamicResource BrushCardBg}"
                      BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="{DynamicResource BrushCardBg}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Root"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource BrushBorderLight}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="2">
                                        <ContentPresenter Margin="14,12"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSurfaceLight}"/>
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushPrimaryLight}"/>
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BrushSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Descripcion}"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       LineHeight="20"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Background="{DynamicResource BrushSurfaceLight}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding FechaCreacion}"
                                               FontSize="11"
                                               Foreground="{DynamicResource BrushTextMuted}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource ActionButtonStyle}" Background="#10B981"
                    Content="Crear" Width="80" Height="30" Margin="4,0"
                    Command="{Binding CrearCommand}" />
                <Button Style="{StaticResource ActionButtonStyle}" Background="#3B82F6"
                    Content="Editar" Width="80" Height="30" Margin="4,0"
                    Command="{Binding EditarCommand}" />
                <Button Style="{StaticResource ActionButtonStyle}" Background="#EF4444"
                    Content="Eliminar" Width="80" Height="30" Margin="4,0"
                    Command="{Binding EliminarCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
