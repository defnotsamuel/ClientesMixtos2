<Window x:Class="ClientesMixtos.Views.AddPagoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Agregar Pago" Height="250" Width="320" MinHeight="250" MinWidth="320"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBg}">

    <Border Background="{DynamicResource BrushCardBg}" CornerRadius="12" Effect="{StaticResource CardShadow}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="16">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Agregar Pago" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="Seleccione la fecha del pago" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <DatePicker SelectedDate="{Binding FechaSeleccionada}"
                        Width="200" HorizontalAlignment="Center"
                        Style="{StaticResource ModernDatePickerStyle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="Aceptar" Style="{StaticResource ActionButtonStyle}"
                        Width="90" Height="34" Margin="0,0,8,0"
                        Command="{Binding AceptarCommand}" IsDefault="True"/>
                <Button Content="Cancelar" Style="{StaticResource OutlineButtonStyle}"
                        Width="90" Height="34"
                        Command="{Binding CancelarCommand}" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
